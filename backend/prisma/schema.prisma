generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// ─── User ──────────────────────────────────────────────
model User {
  id        String    @id @default(uuid()) @db.Uuid
  email     String    @unique
  password  String
  name      String
  startups  Startup[]
  createdAt DateTime  @default(now())
}

/// ─── Startup ───────────────────────────────────────────
model Startup {
  id                String           @id @default(uuid()) @db.Uuid
  userId            String           @db.Uuid
  user              User             @relation(fields: [userId], references: [id])
  name              String
  seed              Int

  // Simulation state
  currentMonth      Int              @default(0)
  status            String           @default("ACTIVE") // ACTIVE | BANKRUPT | ACQUIRED

  // Financial state — stored as integer cents (BigInt)
  cashCents         BigInt           @default(50000000)  // $500,000 seed capital
  mrrCents          BigInt           @default(0)

  // Product
  productPriceCents BigInt           @default(4900)      // $49.00 per month
  qualityScore      Int              @default(30)        // 1–100 product quality

  // Equity — stored as integer basis points (10 000 bps = 100.00%)
  founderEquityBps  Int              @default(10000)

  // Funding flags
  raisedSeed        Boolean          @default(false)
  raisedSeriesA     Boolean          @default(false)

  // Relations
  turns             Turn[]
  employees         Employee[]
  cohorts           CustomerCohort[]
  idempotencyKeys   IdempotencyKey[]

  createdAt         DateTime         @default(now())
  updatedAt         DateTime         @updatedAt
}

/// ─── Turn (immutable monthly snapshot) ─────────────────
model Turn {
  id        String   @id @default(uuid()) @db.Uuid
  startupId String   @db.Uuid
  startup   Startup  @relation(fields: [startupId], references: [id])
  idempotencyKeys IdempotencyKey[]
  month     Int
  snapshot  Json     // Full state snapshot after turn execution
  decisions Json     // Founder decisions that drove this turn
  events    Json     // Market events that occurred
  ledger    Json     // Double-entry accounting ledger rows

  createdAt DateTime @default(now())

  @@unique([startupId, month])
}

/// ─── Employee ──────────────────────────────────────────
model Employee {
  id          String  @id @default(uuid()) @db.Uuid
  startupId   String  @db.Uuid
  startup     Startup @relation(fields: [startupId], references: [id])
  role        String  // ENGINEERING | SALES | MARKETING | SUPPORT
  salaryCents BigInt  // Monthly salary in cents
  hiredMonth  Int
  firedMonth  Int?
  isActive    Boolean @default(true)
}

/// ─── CustomerCohort ────────────────────────────────────
model CustomerCohort {
  id                String  @id @default(uuid()) @db.Uuid
  startupId         String  @db.Uuid
  startup           Startup @relation(fields: [startupId], references: [id])
  acquiredMonth     Int
  initialCount      Int
  currentCount      Int
  monthlyPriceCents BigInt  // Price at time of acquisition
}

/// ─── IdempotencyKey ────────────────────────────────────
model IdempotencyKey {
  key       String   @id
  startupId String   @db.Uuid
  startup   Startup  @relation(fields: [startupId], references: [id])
  turnId    String   @db.Uuid
  turn      Turn     @relation(fields: [turnId], references: [id], onDelete: Restrict, onUpdate: Cascade)
  response  Json     // Cached response body
  createdAt DateTime @default(now())
}
